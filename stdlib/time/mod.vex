// VEX Standard Library — std::time
@extern("vex_time_now_ms") fn nowMs() -> u64
@extern("vex_time_sleep_ms") fn sleepMs(ms: u64)
struct Duration { ns: u64 }
impl Duration {
    fn fromMs(ms: u64) -> Duration { Duration { ns: ms * 1_000_000 } }
    fn fromSecs(s: u64) -> Duration { Duration { ns: s * 1_000_000_000 } }
    fn toMs(self) -> u64 { self.ns / 1_000_000 }
}
